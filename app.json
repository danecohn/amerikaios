{
  "expo": {
    "name": "Vigil Social",
    "slug": "amerika-social",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "amerikasocial",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "social.amerika.ios",
      "supportsTablet": false,
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos or videos to share on Vigil Social.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Optionally verify your US location or show approximate Dating distance. Location is never used in the background.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save branded Vigil Social post images to your photo library.",
          "photosPermission": "Choose media for your posts and Dating profile.",
          "preventAutomaticLimitedAccessAlert": true
        }
      ],
      "expo-notifications"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f1f4",
      "dark": {
        "image": "./assets/splash-icon-dark.png",
        "backgroundColor": "#120a14"
      }
    }
  }
}
